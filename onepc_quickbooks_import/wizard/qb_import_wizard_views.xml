<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="qb_import_wizard_view_form" model="ir.ui.view">
        <field name="name">onepc.qb.import.wizard.form</field>
        <field name="model">onepc.qb.import.wizard</field>
        <field name="arch" type="xml">
            <form string="QuickBooks Import">
                <field name="state" invisible="1"/>
                <div class="alert alert-info" role="alert" invisible="state != 'upload'">
                    Upload a CSV exported from QuickBooks Online or QuickBooks Desktop.
                    <b>Preview</b> is a dry run: nothing is written until you click <b>Import</b>.
                    Existing records are matched (by email or name for contacts, by SKU or
                    name for products, by code or name for accounts) and never duplicated.
                </div>
                <group invisible="state != 'upload'">
                    <group>
                        <field name="import_type" widget="radio"/>
                        <field name="company_id" groups="base.group_multi_company"
                               options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="data_file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                </group>
                <div invisible="state == 'upload'">
                    <div class="alert alert-warning" role="alert" invisible="state != 'preview'">
                        <b>Dry run.</b> Nothing has been imported yet. Review the rows below,
                        then click <b>Import</b>.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'done'">
                        <b>Import finished.</b> The full result is saved in the import history.
                    </div>
                    <group>
                        <group>
                            <field name="import_type" readonly="1"/>
                            <field name="filename" readonly="1" string="File"/>
                        </group>
                        <group>
                            <field name="create_count" string="To create / created"/>
                            <field name="skip_count" string="Skipped (already exist)"/>
                            <field name="error_count" string="Errors"/>
                        </group>
                    </group>
                    <separator string="Columns recognised"/>
                    <field name="columns_html" nolabel="1"/>
                    <separator string="Rows"/>
                    <field name="preview_html" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_preview" type="object" string="Preview"
                            class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary" invisible="state != 'preview'"
                            confirm="Create the records listed as 'Create'?"/>
                    <button name="action_back" type="object" string="Back"
                            invisible="state != 'preview'"/>
                    <button name="action_open_log" type="object" string="Open import log"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button name="action_back" type="object" string="Import another file"
                            invisible="state != 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_qb_import_wizard" model="ir.actions.act_window">
        <field name="name">QuickBooks Import</field>
        <field name="res_model">onepc.qb.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
